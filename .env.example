# LPG Live Optimization System - Configuration

## Environment Variables
FLASK_ENV=development
FLASK_APP=backend/app.py
FLASK_DEBUG=1

## Database
DATABASE_URL=postgresql://user:password@localhost:5432/lpg_optimizer

## API Configuration
API_HOST=0.0.0.0
API_PORT=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

## Optimization Settings
OPTIMIZATION_INTERVAL_HOURS=6
SERVICE_LEVEL_TARGET=0.95
USE_VAM=True
USE_DP=True
USE_NETWORK_FLOW=True

## Data Pipeline
DATA_FETCH_INTERVAL_SECONDS=300
DEMAND_API_URL=https://api.example.com/demand
SUPPLY_API_URL=https://api.example.com/supply

## Logging
LOG_LEVEL=INFO
LOG_FILE=logs/lpg_optimizer.log

## Frontend
REACT_APP_API_URL=http://localhost:5000/api
